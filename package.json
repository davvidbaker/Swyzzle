{
  "name": "swyzzle",
  "version": "1.0.0",
  "description": "Interactive WebGL melt effects for the web and Electron",
  "type": "module",
  "main": "./dist/swyzzle.js",
  "module": "./dist/swyzzle.js",
  "exports": {
    ".": "./dist/swyzzle.js",
    "./core": "./src/core/SwyzzleRenderer.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node scripts/start-electron.js",
    "dev:web": "esbuild demo/app.js --bundle --outfile=demo/bundle.js --servedir=.",
    "build": "npm run build:web && npm run build:global",
    "build:web": "esbuild src/index.js --bundle --format=esm --outfile=dist/swyzzle.js --sourcemap",
    "build:global": "esbuild src/index.js --bundle --format=iife --global-name=SwyzzlePackage --outfile=dist/swyzzle.global.js --sourcemap",
    "lint": "eslint src electron demo scripts tests playwright.config.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "npm run build:web && playwright test",
    "check": "npm run lint && npm test && npm run build && npm run test:browser",
    "prepack": "npm run check"
  },
  "author": "David",
  "license": "MIT",
  "keywords": [
    "webgl",
    "shader",
    "electron",
    "melt",
    "visual-effect"
  ],
  "dependencies": {
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "electron": "^44.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0"
  }
}
